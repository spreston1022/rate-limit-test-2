      "handler": {
        "module": "$import(@zuplo/runtime)",
        "export": "OpenIdJwtInboundPolicy",
        "options": {
          "issuer": "https://test-idp.rate-limit-test.local",
          "jwkUrl": "https://rate-limit-test-2-main-d5e669e.oracle-poc.zuplo.work/.well-known/jwks.json",
