      "handler": {
        "module": "$import(@zuplo/runtime)",
        "export": "RateLimitInboundPolicy",
        "options": {
          "rateLimitBy": "function",
          "requestsAllowed": 2,
          "timeWindowMinutes": 1,
          "identifier": {
            "module": "$import(./modules/rate-limits)",
            "export": "userKey"
          },
          "headerMode": "none"
        }
      }
    },
