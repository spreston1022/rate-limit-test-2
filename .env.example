# Environment variables for local development.
#
# Copy this file to .env. `zuplo dev` loads .env automatically, and .env is
# gitignored. For deployed environments set the same variables in the Zuplo
# Portal under Settings > Environment Variables.

# Origin that every route forwards to. Replace with the real backend.
ORIGIN_URL=https://echo.zuplo.io

# JWT validation for bearer tokens. These defaults use the stand-in IdP served
# by this gateway (see tests/token.mjs); swap for the real IdP's values.
JWT_ISSUER=https://test-idp.rate-limit-test.local
JWKS_URL=http://localhost:9000/.well-known/jwks.json

# Optional overrides for how a user is identified (modules/rate-limits.ts).
# USER_CLAIM=user_id
# USER_ID_HEADER=userId
# TENANT_HEADER=x-prime-tenant
